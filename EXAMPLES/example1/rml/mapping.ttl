@prefix rml:  <http://w3id.org/rml/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://example.com/soil/> .


############################################################
# SOIL HORIZON / SAMPLE
############################################################

<#SampleMapping>
    a rml:TriplesMap ;

    rml:logicalSource [
        rml:source "../soveur.csv" ;
        rml:referenceFormulation rml:CSV
    ] ;

    rml:subjectMap [
        rml:template "http://example.com/soil/sample/{PRID}/{HONU}" ;
        rml:class ex:SoilHorizon
    ] .


############################################################
# PROFILE / LOCATION
############################################################

<#LatitudeObservation>
    a rml:TriplesMap ;

    rml:logicalSource [
        rml:source "../soveur.csv" ;
        rml:referenceFormulation rml:CSV
    ] ;

    rml:subjectMap [
        rml:template
            "http://example.com/soil/observation/{PRID}/{HONU}/LATI" ;
        rml:class sosa:Observation
    ] ;

    rml:predicateObjectMap [
        rml:predicate sosa:hasFeatureOfInterest ;
        rml:objectMap [
            rml:template
                "http://example.com/soil/sample/{PRID}/{HONU}"
        ]
    ] ;

    rml:predicateObjectMap [
        rml:predicate sosa:observedProperty ;
        rml:objectMap [
            rml:constant ex:latitude
        ]
    ] ;

    rml:predicateObjectMap [
        rml:predicate sosa:hasSimpleResult ;
        rml:objectMap [
            rml:reference "LATI" ;
            rml:datatype xsd:decimal
        ]
    ] .


<#LongitudeObservation>
