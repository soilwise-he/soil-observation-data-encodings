@prefix rml:  <http://w3id.org/rml/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://data.soilwise-he.eu/soveur/> .
@prefix ql:  <http://semweb.mmlab.be/ns/ql#> .
@prefix schema:  <http://schema.org/> .
@prefix iso28258:  <http://w3id.org/glosis/model/iso28258/2013/> .
@prefix props: <http://w3id.org/glosis/model/codelists/properties/> .

############################################################
# SOIL PROFILE
############################################################

<#ProfileMapping>
    a rml:TriplesMap ;
    
    rml:logicalSource [
        rml:source "../soveur.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rml:subjectMap [
        rml:template "http://data.soilwise-he.eu/soveur/{PRID}" ;
        rml:class iso28258:profile
    ] ;

    rml:predicateObjectMap [
        rml:predicate schema:latitude ;
        rml:objectMap [
            rml:reference "LATI" ;
            rml:datatype xsd:decimal
        ]
    ] ;

    rml:predicateObjectMap [
        rml:predicate schema:longitude ;
        rml:objectMap [
            rml:reference "LNGI" ;
            rml:datatype xsd:decimal
        ]
    ] ;
    
    rml:predicateObjectMap [
        rml:predicate schema:elevation ;
        rml:objectMap [
            rml:reference "ELEV" ;
            rml:datatype xsd:decimal
        ]
    ] .

############################################################
# PROFILE / LOCATION
############################################################

<#HorizonMapping>
    a rml:TriplesMap ;
    
    rml:logicalSource [
        rml:source "../soveur.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rml:subjectMap [
        rml:template "http://data.soilwise-he.eu/soveur/soveur/horizon/{PRID}/{HONU}" ;
        rml:class iso28258:Horizon
    ] ;

    rml:predicateObjectMap [
        rml:predicate iso28258:upperDepth ;
        rml:objectMap [
            rml:reference "HBUP" ;
            rml:datatype xsd:decimal
        ]
    ] ;

    rml:predicateObjectMap [
        rml:predicate iso28258:lowerDepth ;
        rml:objectMap [
            rml:reference "HBDE" ;
            rml:datatype xsd:decimal
        ]
    ] ;

    rml:predicateObjectMap [
        rml:predicate iso28258:horizonDesignation ;
        rml:objectMap [
            rml:reference "HODE"
        ]
    ] .


############################################################
# HORIZON DESCRIPTIVE OBSERVATIONS
############################################################

<#HorizonObservationMapping>
    a rml:TriplesMap ;

    rml:logicalSource [
        rml:source "../soveur.csv" ;
        rml:referenceFormulation rml:CSV
    ] ;

    rml:subjectMap [
        rml:template
            "http://data.soilwise-he.eu/soveur/observation/{PRID}/{HONU}/HODE" ;
        rml:class sosa:Observation
    ] ;

    rml:predicateObjectMap [
        rml:predicate sosa:hasFeatureOfInterest ;
        rml:objectMap [
            rml:template
                "http://data.soilwise-he.eu/soveur/horizon/{PRID}/{HONU}"
        ]
    ] ;

    rml:predicateObjectMap [
        rml:predicate sosa:observedProperty ;
        rml:objectMap [
            rml:constant props:horizonDesignation
        ]
    ] ;

    rml:predicateObjectMap [
        rml:predicate sosa:hasSimpleResult ;
        rml:objectMap [
            rml:reference "HODE"
        ]
    ] .


